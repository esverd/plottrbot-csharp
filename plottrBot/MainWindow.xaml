<Window x:Name="Warhol_Slicer" 
        x:Class="plottrBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Warhol Slicer"
        Height="1000" Width="1600"
        Icon="scarJo-small.bmp">

    <!-- 
       Top-level Grid with two columns:
         Column 0: TabControl (menu)
         Column 1: Preview area
    -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Left (TabControl) -->
            <ColumnDefinition Width="*"/>
            <!-- Right (Preview) -->
        </Grid.ColumnDefinitions>

        <!-- =========================
             TAB CONTROL on the LEFT
        ========================== -->
        <TabControl x:Name="tabControlOptions"
                   FontSize="14"
                   Grid.Column="0"
                   Margin="0,0,10,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch">

            <!-- =========== TAB #1: CONTROL =========== -->
            <TabItem Header="Control">
                <!-- 
                    ScrollViewer ensures content scrolls 
                    if it's too large for the visible area.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 
                        A vertical StackPanel to lay out:
                          1) "Image options" block
                          2) "Robot control" block
                    -->
                    <StackPanel Background="#FFFBFBFB" Margin="10">

                        <!-- =============== IMAGE OPTIONS =============== -->
                        <Border BorderBrush="#FFC7C7C7" BorderThickness="1"
                                Margin="0,0,0,10"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Image options" 
                                           FontSize="20" 
                                           Margin="0,0,0,10"/>

                                <Button x:Name="btnSelectImg"
                                        Content="Select image"
                                        Height="34"
                                        Background="#FF8B8B8B"
                                        FontSize="16"
                                        Margin="0,0,0,10"
                                        Click="btnSelectImg_Click"/>

                                <!-- X-position row -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="X = " 
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtMoveX"
                                             Text="0"
                                             Width="50"
                                             Margin="5,0,0,0"
                                             VerticalAlignment="Center"
                                             ToolTip="Position of top left image corner"/>
                                    <TextBlock Text="[mm]"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="btnMoveImg"
                                            Content="Set position"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="btnMoveImg_Click"/>
                                </StackPanel>

                                <!-- Y-position row -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Y = "
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtMoveY"
                                             Text="0"
                                             Width="50"
                                             Margin="5,0,0,0"
                                             VerticalAlignment="Center"
                                             ToolTip="Position of top left image corner"/>
                                    <TextBlock Text="[mm]"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="btnCenterImg"
                                            Content="Move top left"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="btnCenterImg_Click"/>
                                </StackPanel>

                                <!-- Clear image -->
                                <Button x:Name="btnClearImg"
                                        Content="Clear"
                                        Height="34"
                                        Background="#FF8B8B8B"
                                        FontSize="16"
                                        Margin="0,0,0,10"
                                        Click="btnClearImg_Click"/>

                                <!-- Zoom out / Zoom in row -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <Button x:Name="btnZoomOut"
                                            Content="Zoom out"
                                            Margin="0,0,10,0"
                                            FontSize="14"
                                            Click="btnZoomOut_Click"/>
                                    <Button x:Name="btnZoomIn"
                                            Content="Zoom in"
                                            FontSize="14"
                                            Click="btnZoomIn_Click"/>
                                </StackPanel>

                                <!-- Slice image -->
                                <Button x:Name="btnSliceImg"
                                        Content="Slice image"
                                        Height="34"
                                        Background="#FF8B8B8B"
                                        FontSize="16"
                                        Margin="0,0,0,10"
                                        Click="btnSliceImg_Click"/>

                                <!-- Hold image -->
                                <Button x:Name="btnHoldImg"
                                        Content="Hold image"
                                        FontSize="14"
                                        Height="26"
                                        Click="btnHoldImg_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- =============== ROBOT CONTROL =============== -->
                        <Border BorderBrush="#FFC7C7C7" BorderThickness="1"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Robot control"
                                           FontSize="20"
                                           Margin="0,0,0,10"/>

                                <!-- COM port + Connect USB -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,10">
                                    <ComboBox x:Name="comboBoxCOM"
                                              Width="150" Height="27"
                                              DropDownOpened="comboBoxCOM_DropDownOpened"/>
                                    <Button x:Name="btnConnect"
                                            Content="Connect USB"
                                            Width="130" Height="27"
                                            Margin="10,0,0,0"
                                            FontSize="14"
                                            Click="btnConnect_Click"/>
                                </StackPanel>

                                <!-- Move in bounding box formation -->
                                <Button x:Name="btnBoundingBox"
                                        Content="Move in bounding box formation"
                                        FontSize="14"
                                        Height="27"
                                        Margin="0,0,0,10"
                                        ToolTip="Moves the drawing head in a square box indicating the furthest pixels in all directions"
                                        Click="btnBoundingBox_Click"/>

                                <!-- Pause drawing -->
                                <Button x:Name="btnPauseDrawing"
                                        Content="Pause drawing"
                                        FontSize="14"
                                        Height="27"
                                        Margin="0,0,0,10"
                                        Click="btnPauseDrawing_Click"/>

                                <!-- Send image to robot -->
                                <Button x:Name="btnSendImg"
                                        Content="Send image to robot"
                                        Height="34"
                                        Background="#FF8B8B8B"
                                        FontSize="16"
                                        Click="btnSendImg_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========== TAB #2: ADVANCED =========== -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Background="#FFFBFBFB" Margin="10">

                        <!-- Status messages -->
                        <TextBox x:Name="txtOut"
                                 Text="Status messages&#xA;"
                                 VerticalScrollBarVisibility="Visible"
                                 IsReadOnly="True"
                                 Height="136"
                                 Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="txtSerialCmd"
                                     Width="180" Height="27"
                                     KeyDown="txtSerialCmd_KeyDown"/>
                            <Button x:Name="btnSend"
                                    Content="Send serial msg"
                                    Width="100" Height="27"
                                    Margin="10,0,0,0"
                                    Click="btnSend_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="checkBoxDrawingBoundingBox"
                                  Content="Use pen when indicating bounding box"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <!-- End GCODE -->
                        <TextBlock Text="End GCODE" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEndGcode"
                                 Text="G1 Z1&#xA;G28&#xA;"
                                 AcceptsReturn="True"
                                 Height="93"
                                 Margin="0,0,0,10"/>

                        <!-- Start cmd number -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="txtCmdStart"
                                     Width="60" Height="27"
                                     TextAlignment="Right"
                                     Text="0"
                                     KeyDown="txtCmdStart_KeyDown"/>
                            <Button x:Name="btnCmdStart"
                                    Content="Start from cmd number"
                                    Width="160" Height="27"
                                    Margin="10,0,0,0"
                                    Click="btnCmdStart_Click"/>
                        </StackPanel>

                        <!-- Enable/Disable motors -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnEnableStepper"
                                    Content="Enable motors"
                                    Width="100" Height="27"
                                    Click="btnEnableStepper_Click"/>
                            <Button x:Name="btnDisableStepper"
                                    Content="Disable motors"
                                    Width="100" Height="27"
                                    Margin="10,0,0,0"
                                    Click="btnDisableStepper_Click"/>
                        </StackPanel>

                        <!-- Tool to canvas -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnPenTouchCanvas"
                                    Content="Set tool to canvas"
                                    Width="120" Height="27"
                                    Click="btnPenTouchCanvas_Click"/>
                            <Button x:Name="btnNoPenTouchCanvas"
                                    Content="Set away from canvas"
                                    Width="120" Height="27"
                                    Margin="10,0,0,0"
                                    Click="btnNoPenTouchCanvas_Click"/>
                        </StackPanel>

                        <!-- Home position -->
                        <Button x:Name="btnHomePosition"
                                Content="Move to home position"
                                Height="27"
                                Margin="0,0,0,10"
                                Click="btnHomePosition_Click"/>

                        <!-- Command slider -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Slider x:Name="sliderCmdCount"
                                    Width="200"
                                    SmallChange="1"
                                    ValueChanged="sliderCmdCount_ValueChanged"/>
                            <Button x:Name="btnSliderDecrease"
                                    Content="&lt;"
                                    Width="20" Margin="5,0,0,0"
                                    Click="btnSliderIncDec"/>
                            <Button x:Name="btnSliderIncrease"
                                    Content="&gt;"
                                    Width="20" Margin="5,0,0,0"
                                    Click="btnSliderIncDec"/>
                        </StackPanel>

                        <!-- Robot dimensions -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Robot width" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtRWidth"
                                     Width="60" Height="24"
                                     Margin="5,0,0,0"
                                     Text="0" TextAlignment="Right"/>
                            <TextBlock Text="[mm]"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Robot height" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtRHeight"
                                     Width="60" Height="24"
                                     Margin="5,0,0,0"
                                     Text="0" TextAlignment="Right"/>
                            <TextBlock Text="[mm]"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="btnSaveDimension"
                                Content="Save dimensions"
                                Height="26"
                                Click="btnSaveDimension_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- =========================
             PREVIEW AREA on the RIGHT
        ========================== -->
        <Border x:Name="borderPreview"
                Grid.Column="1"
                BorderBrush="Black"
                BorderThickness="1"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <ScrollViewer x:Name="scrollViewerHoldingCanvasPreview"
                          BorderBrush="Black"
                          BorderThickness="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <Canvas x:Name="canvasPreview"
                        Width="1200"
                        Height="800"
                        RenderTransformOrigin="0.481,0.251"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
